resource app_signature "application/x-vnd.storytold-PhotoCraft";
// Preserve this attribute inside the hpkg for Tracker's initial document refs.
resource(2, "BEOS:TYPE") #'MIMS' "application/x-vnd.Be-elfexecutable";
resource app_flags B_MULTIPLE_LAUNCH;
resource app_version {
    major = 0, middle = 17, minor = 0, variety = B_APPV_DEVELOPMENT, internal = 1,
    short_info = "PhotoCraft 0.17.0",
    long_info = "PhotoCraft image editor for air/OS (MIT or Apache-2.0)."
};
resource vector_icon { import "PhotoCraft.hvif" };
resource file_types message { "types" = "application/x-photocraft", "types" = "image/vnd.adobe.photoshop", "types" = "image/png", "types" = "image/jpeg" };
